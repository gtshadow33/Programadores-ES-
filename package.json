{
  "name": "programadores-es",
  "version": "1.0.0",
  "description": "Aplicación de escritorio desarrollada con Electron",
  "keywords": [
    "electron",
    "nodejs",
    "sqlite3"
  ],
  "homepage": "https://github.com/gtshadow33/Programadores-ES-#readme",
  "bugs": {
    "url": "https://github.com/gtshadow33/Programadores-ES-/issues"
  },
  "license": "ISC",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gtshadow33/Programadores-ES-.git"
  },
  "main": "src/main/main.js",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "dist": "electron-builder --linux AppImage",
    "test": "jest",
    "css:build": "npx @tailwindcss/cli -i src/renderer/css/input.css -o src/renderer/css/styles.css --minify",
    "css:watch": "npx @tailwindcss/cli -i src/renderer/css/input.css -o src/renderer/css/styles.css --watch"
  },
  "build": {
    "appId": "com.programadoreses.app",
    "productName": "Hazlo",
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "jest": "^30.4.2",
    "tailwindcss": "^4.3.3"
  }
}
